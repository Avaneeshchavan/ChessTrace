DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/db?sslmode=require&connection_limit=2
DIRECT_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require
JWT_SECRET=
VISION_ENGINE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=5001

# Compact search is opt-in after loading and verifying a compact corpus.
USE_COMPACT_STORAGE=false
# Distinct corpus games required for a position to count as part of the indexed line.
TWIN_MIN_GAMES=3
STORAGE_PROFILE=mvp
